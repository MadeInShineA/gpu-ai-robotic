        //
        //  current folder (debug)
        //
        {
            "label": "ls",
            "type": "shell",
            "command": "pwd; ls -la",
            "options": {
                "cwd": "${fileWorkspaceFolder}" // fileWorkspaceFolder workspaceFolder
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }, // end current folder 
        //
        // --------------------------------------------------------
        // Tasks  
        // --------------------------------------------------------
        //
        //  format current file
        //
        {
            "label": "format current file",
            "type": "shell",
            "command": "clang-format -i \"${file}\"", // sudo apt install clang-format
        }, // end format current file
        //
        //  format all file
        //
        {
            "label": "format all files",
            "type": "shell",
            "command": "find . -type f \\( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.cu' -o -name '*.cu.h' \\) -exec clang-format -i {} +", // sudo apt install clang-format
            "problemMatcher": []
        }, // end format all file
        //
        // cockpit
        //
        {
            "label": "cockpit",
            "type": "shell",
            //"command": "nohup cockpit", // nohup ou disown : Empêche le processus d'être tué lorsque le terminal parent se ferme. > /dev/null 2>&1 : Cache les logs textuels pour éviter de polluer VS Code.
            "command": "nohup cockpit  > /dev/null 2>&1",
            //"isBackground": false,
            "presentation": {
                "clear": true, // Before executing the task, VS Code clears the previous terminal content.
                "reveal": "always", // Always opens the terminal when the task starts.
                "panel": "dedicated" // "shared" / "dedicated": "shared" -> all tasks use the same terminal.
