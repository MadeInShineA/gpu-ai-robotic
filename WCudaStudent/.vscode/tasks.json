{
    "version": "2.0.0",
    "tasks": [
        //
        // cbicc cuda clean 
        //
        {
            "label": "cbicc cuda clean",
            "type": "shell",
            "command": "cbicc cuda clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true, // Before executing the task, VS Code clears the previous terminal content.
                "reveal": "always", // Always opens the terminal when the task starts.
                "panel": "dedicated" // "shared" / "dedicated": "shared" -> all tasks use the same terminal.
            },
            "group": "build"
        }, // cbicc cuda clean 
        //
        // cbicc cuda jall
        //
        {
            "label": "cbicc cuda jall",
            "type": "shell",
            "command": "cbicc cuda jall",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true, // Before executing the task, VS Code clears the previous terminal content.
                "reveal": "always", // Always opens the terminal when the task starts.
                "panel": "dedicated" // "shared" / "dedicated": "shared" -> all tasks use the same terminal.
            },
            "group": "build",
            "problemMatcher": {
                "owner": "cbicc-compiler",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$", // avec warning//
                    // "regexp": "^(.+):(\\d+):(\\d+):\\s*(error):\\s+(.*)$", // san warning
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }, // end cbicc cuda jall 
        //
        // cbicc cuda run 
        //
        {
            "label": "cbicc cuda run",
            "type": "shell",
