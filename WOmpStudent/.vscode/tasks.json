{
    "version": "2.0.0",
    "tasks": [
        //
        // --------------------------------------------------------
        // gcc  
        // --------------------------------------------------------
        //
        //
        // cbicc gcc clean 
        //
        {
            "label": "cbicc gcc clean",
            "type": "shell",
            "command": "cbicc gcc clean",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true, // Before executing the task, VS Code clears the previous terminal content.
                "reveal": "always", // Always opens the terminal when the task starts.
                "panel": "dedicated" // "shared" / "dedicated": "shared" -> all tasks use the same terminal.
            },
            "group": "build"
        }, // cbicc gcc clean 
        //
        // cbicc gcc jall
        //
        {
            "label": "cbicc gcc jall",
            "type": "shell",
            "command": "cbicc gcc jall",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "clear": true, // Before executing the task, VS Code clears the previous terminal content.
                "reveal": "always", // Always opens the terminal when the task starts.
                "panel": "dedicated" // "shared" / "dedicated": "shared" -> all tasks use the same terminal.
            },
            "group": "build",
            "problemMatcher": {
                "owner": "cbicc-compiler",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$", // avec warning//
                    // "regexp": "^(.+):(\\d+):(\\d+):\\s*(error):\\s+(.*)$", // sans warning
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }, // end cbicc gcc jall 
