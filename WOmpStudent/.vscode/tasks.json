        //
        // --------------------------------------------------------
        // Tasks  
        // --------------------------------------------------------
        //
        //  format current file
        //
        {
            "label": "format current file",
            "type": "shell",
            "command": "clang-format -i \"${file}\"", // sudo apt install clang-format
        }, // end format current file
        //
        //  format all file
        //
        {
            "label": "format all files",
            "type": "shell",
            "command": "find . -type f \\( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.cu' -o -name '*.cu.h' \\) -exec clang-format -i {} +", // sudo apt install clang-format
            "problemMatcher": []
        } // end format all file
